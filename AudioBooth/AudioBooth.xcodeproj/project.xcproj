    { "path": "<PROJECT>/../CHANGELOG.md", "target-membership": [ "AudioBooth/resources" ] },
    {
      "kind": "group",
      "name": "Frameworks",
      "children": [
        { "path": "<SDK>/System/Library/Frameworks/StoreKit.framework", "target-membership": [ "AudioBooth/frameworks" ] },
        {
          "path": "<SDK>/System/Library/Frameworks/WidgetKit.framework",
          "target-membership": [
            "AudioBoothWidgetExtension/frameworks",
            "AudioBoothWatchWidgetExtension/frameworks",
          ],
        }, {
          "path": "<SDK>/System/Library/Frameworks/SwiftUI.framework",
          "target-membership": [
            "AudioBoothWidgetExtension/frameworks",
            "AudioBoothWatchWidgetExtension/frameworks",
          ],
        },
      ],
    }, {
      "kind": "group",
      "name": "Packages",
      "children": [
        { "path": "<PROJECT>/../API" },
        { "path": "../Models" },
        { "path": "<PROJECT>/../PlayerIntents" },
      ],
    }, {
      "kind": "group",
      "name": "Products",
      "children": [
        { "path": "<PRODUCTS>/AudioBooth.app", "id": "3FC8DC6E2E638F5E00A4B080", "type": "wrapper.application", "index": false },
        { "path": "<PRODUCTS>/AudioBooth Watch App.app", "id": "3FBEA0652E8CD49300976BA0", "type": "wrapper.application", "index": false, "target-membership": [ { "build-phase": "AudioBooth/copy/Embed Watch Content", "platforms": [ "ios" ], "header-preservation": "remove-on-copy" } ] },
        { "path": "<PRODUCTS>/AudioBoothWidgetExtension.appex", "id": "3F2D3BF32EBE711800D49AFF", "type": "wrapper.app-extension", "index": false, "target-membership": [ { "build-phase": "AudioBooth/copy/Embed Foundation Extensions", "platforms": [ "ios" ], "header-preservation": "remove-on-copy" } ] },
        { "path": "<PRODUCTS>/AudioBoothWatchWidgetExtension.appex", "id": "3F5A20502F6E656C00CFD89E", "type": "wrapper.app-extension", "index": false, "target-membership": [ { "build-phase": "AudioBooth Watch App/copy/Embed Foundation Extensions", "header-preservation": "remove-on-copy" } ] },
        { "path": "<PRODUCTS>/AudioBoothTests.xctest", "id": "3FC8DC6E2E638F5E00A4B099", "type": "wrapper.cfbundle", "index": false },
      ],
    },
    { "path": "Signing.xcconfig" },
  ],
  "targets": [
    {
      "name": "AudioBooth",
      "id": "3FC8DC6D2E638F5E00A4B080",
      "product": "Products/AudioBooth.app",
      "product-type": "application",
      "dependencies": [
        { "target": "AudioBooth Watch App", "platforms": [ "ios" ] },
        { "target": "AudioBoothWidgetExtension", "platforms": [ "ios" ] },
      ],
      "build-phases": [
        "compile-sources",
        "frameworks",
        "resources",
        {
          "kind": "copy",
          "name": "Embed Watch Content",
          "bundle-base-path": "build-products-directory",
          "relative-path": "$(CONTENTS_FOLDER_PATH)/Watch",
        }, {
          "kind": "copy",
          "name": "Embed Foundation Extensions",
          "bundle-base-path": "plugins-directory",
        }, {
          "kind": "script",
          "name": "Set Build Number",
          "log-environment-variables": true,
          "input-paths": [
            "$(TARGET_BUILD_DIR)/$(INFOPLIST_PATH)",
          ],
          "run-on-every-build": true,
          "shell": "/bin/sh",
          "script": [
            "if [ \"$CONFIGURATION\" = \"Release\" ]; then",
            "    TIMESTAMP=$(date -u +%s)",
            "    ",
            "    IOS_PLIST=\"${TARGET_BUILD_DIR}/${INFOPLIST_PATH}\"",
            "    /usr/libexec/PlistBuddy -c \"Set :CFBundleVersion $TIMESTAMP\" \"$IOS_PLIST\"",
            "    echo \"Updated iOS build number to: $TIMESTAMP\"",
            "    ",
            "    WATCH_PLIST=\"${TARGET_BUILD_DIR}/${PRODUCT_NAME}.app/Watch/${PRODUCT_NAME} Watch App.app/Info.plist\"",
            "",
            "    if [ -f \"$WATCH_PLIST\" ]; then",
            "        /usr/libexec/PlistBuddy -c \"Set :CFBundleVersion $TIMESTAMP\" \"$WATCH_PLIST\"",
            "        echo \"Updated watchOS build number to: $TIMESTAMP\"",
            "    else",
            "        echo \"Watch app not found at: $WATCH_PLIST\"",
            "    fi",
            "",
            "    WIDGET_PLIST=\"${TARGET_BUILD_DIR}/${PRODUCT_NAME}.app/PlugIns/${PRODUCT_NAME}WidgetExtension.appex/Info.plist\"",
            "",
            "    if [ -f \"$WIDGET_PLIST\" ]; then",
            "        /usr/libexec/PlistBuddy -c \"Set :CFBundleVersion $TIMESTAMP\" \"$WIDGET_PLIST\"",
            "        echo \"Updated widget build number to: $TIMESTAMP\"",
            "    else",
            "        echo \"Widget extension not found at: $WIDGET_PLIST\"",
            "    fi",
            "    ",
            "    echo \"Both apps updated to build: $TIMESTAMP\"",
            "fi",
            "",
          ],
        },
      ],
      "package-product-members": [
        {
          "product-name": "API",
          "build-phase": { "build-phase": "frameworks" },
        }, {
          "product-name": "Models",
          "build-phase": { "build-phase": "frameworks" },
        }, {
          "product-name": "PlayerIntents",
          "build-phase": { "build-phase": "frameworks" },
        }, {
          "package": "KSCrash",
          "product-name": "Installations",
          "build-phase": { "build-phase": "frameworks" },
        }, {
          "package": "KSCrash",
          "product-name": "Recording",
          "build-phase": { "build-phase": "frameworks" },
        }, {
          "package": "KSCrash",
          "product-name": "Reporting",
          "build-phase": { "build-phase": "frameworks" },
        }, {
          "package": "Pulse",
          "product-name": "Pulse",
          "build-phase": { "build-phase": "frameworks" },
        }, {
          "package": "Pulse",
          "product-name": "PulseProxy",
          "build-phase": { "build-phase": "frameworks" },
        }, {
          "package": "Pulse",
          "product-name": "PulseUI",
          "build-phase": { "build-phase": "frameworks" },
        }, {
          "package": "PulseLogHandler",
          "product-name": "PulseLogHandler",
          "build-phase": { "build-phase": "frameworks" },
        }, {
          "package": "RichText",
          "product-name": "RichText",
          "build-phase": { "build-phase": "frameworks" },
        }, {
          "package": "purchases-ios-spm",
          "product-name": "RevenueCat",
          "build-phase": { "build-phase": "frameworks" },
        }, {
          "package": "purchases-ios-spm",
          "product-name": "RevenueCatUI",
          "build-phase": { "build-phase": "frameworks" },
        }, {
          "package": "swift-log",
          "product-name": "Logging",
          "build-phase": { "build-phase": "frameworks" },
        }, {
          "package": "swift-toolkit",
          "product-name": "ReadiumAdapterGCDWebServer",
          "build-phase": { "build-phase": "frameworks" },
        }, {
          "package": "swift-toolkit",
          "product-name": "ReadiumNavigator",
          "build-phase": { "build-phase": "frameworks" },
        }, {
          "package": "swift-toolkit",
          "product-name": "ReadiumStreamer",
          "build-phase": { "build-phase": "frameworks" },
        }, {
          "package": "google-cast-ios-sdk",
          "product-name": "GoogleCastDynamic",
          "build-phase": {
            "build-phase": "frameworks",
            "code-sign-on-copy": true,
          },
        },
      ],
      "build-settings": {
        "ASSETCATALOG_COMPILER_ALTERNATE_APPICON_NAMES": "AppIcon-Blue AppIcon-Dark AppIcon-Green AppIcon-Purple AppIcon-Red AppIcon-Yellow AppIcon-Teal AppIcon-Pink",
        "ASSETCATALOG_COMPILER_APPICON_NAME": "AppIcon",
        "ASSETCATALOG_COMPILER_INCLUDE_ALL_APPICON_ASSETS": "YES",
        "CLANG_ENABLE_OBJC_WEAK": "YES",
        "CODE_SIGN_ENTITLEMENTS[config=Debug]": "AudioBooth/AudioBooth.entitlements",
        "CODE_SIGN_ENTITLEMENTS[config=Release]": "AudioBooth/AudioBooth.entitlements",
        "CODE_SIGN_ENTITLEMENTS[config=Release][sdk=macosx*]": "AudioBooth/AudioBooth Mac.entitlements",
        "ENABLE_PREVIEWS": "YES",
        "ENABLE_USER_SCRIPT_SANDBOXING": "NO",
        "INFOPLIST_FILE": "AudioBooth/Info.plist",
        "IPHONEOS_DEPLOYMENT_TARGET": "17.0",
        "LD_RUNPATH_SEARCH_PATHS": "$(inherited) @executable_path/Frameworks",
        "OTHER_LDFLAGS": "$(inherited) -ObjC",
        "PRODUCT_BUNDLE_IDENTIFIER": "$(ORG_IDENTIFIER).AudioBS",
        "SUPPORTS_MACCATALYST": "YES",
        "SUPPORTS_MAC_DESIGNED_FOR_IPHONE_IPAD": "NO",
        "SWIFT_DEFAULT_ACTOR_ISOLATION": "MainActor",
        "TARGETED_DEVICE_FAMILY": "1,2,6",
      },
