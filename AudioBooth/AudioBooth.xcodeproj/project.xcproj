          ],
        },
      ],
    }, {
      "kind": "folder",
      "path": "AudioBoothWatchWidget",
      "target-membership": [
        "AudioBoothWatchWidgetExtension",
      ],
      "membership-exceptions": [
        {
          "target": "AudioBooth Watch App",
          "inclusions": [
            "Complications/WatchComplicationEntry.swift",
          ],
        }, {
          "target": "AudioBoothWatchWidgetExtension",
          "exclusions": [
            "Info.plist",
          ],
        },
      ],
    }, {
      "kind": "folder",
      "path": "AudioBoothWidget",
